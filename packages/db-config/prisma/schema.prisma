generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int            @id @unique @default(autoincrement())
  name         String
  email        String         @unique
  password     String
  credits      Int            @default(0)
  createdAt    DateTime       @default(now())
  api_keys     API_Key[]
  transactions Transactions[]
}

model API_Key {
  id          Int             @id @unique @default(autoincrement())
  key         String          @unique
  key_name    String
  active      Boolean         @default(true)
  deleted     Boolean         @default(false)
  userId      Int
  expires_at  String
  user        User            @relation(fields: [userId], references: [id])
  generations Conversations[]
}

model Models {
  id        String    @id @unique @default(uuid())
  name      String    @unique
  companyId String
  company   Companies @relation(fields: [companyId], references: [id])
}

model Companies {
  id      String   @id @unique @default(uuid())
  name    String   @unique
  website String?
  model   Models[]
}

model Conversations {
  id            Int      @id @unique @default(autoincrement())
  api_key       String
  inpTokenCount Int
  outTokenCount Int
  createdAt     DateTime @default(now())
  apiKey        API_Key  @relation(fields: [api_key], references: [key])
}

model Transactions {
  id        Int      @id @unique @default(autoincrement())
  userId    Int
  amount    Int
  status    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
